# Preferred: copy config/llm_providers.example.json to config/llm_providers.local.json,
# then put real keys under config/secrets/*.txt.
DEEPSEEK_API_KEY_FILE=config/secrets/deepseek_api_key.txt

# Fallbacks for direct environment configuration:
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
