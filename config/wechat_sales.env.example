# Copy to protected deployment configuration; never commit real values.
# Official-account callback credentials. AppSecret is not used by this service.
WECHAT_TOKEN=replace_me
WECHAT_APP_ID=wx_replace_me
# Required when the official-account message encryption mode is safe mode.
WECHAT_ENCODING_AES_KEY=replace_with_the_43_character_key
# The built-in estimator runs in this same service; keep the call on loopback.
ECCOMMENT_ESTIMATE_URL=http://127.0.0.1:8511/api/sales/estimate
# Generate once on the server, for example with: openssl rand -hex 32
# The caller and the estimate endpoint read the same value from this file.
ECCOMMENT_ESTIMATE_TOKEN=replace_me
ECCOMMENT_PROJECTS_DIR=/opt/tmall-comment/projects
# Keep this below WeChat's passive-reply deadline.
ECCOMMENT_TIMEOUT_SECONDS=4
